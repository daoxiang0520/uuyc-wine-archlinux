From c835e2cca986a2c1989a993e4f8e98f2ab0305c5 Mon Sep 17 00:00:00 2001
From: daoxiang0520 <15959866515@163.com>
Date: Fri, 18 Sep 2026 12:48:49 +0800
Subject: [PATCH] shell32: Initialise the window property store output
 parameters.

GetCount/GetAt/GetValue returned E_NOTIMPL without touching the output
parameter. A caller that does not check the HRESULT reads uninitialised
memory; for GetValue that means an arbitrary PROPVARIANT, and when the
uninitialised vt reads as VT_LPWSTR the caller dereferences an arbitrary
pointer.
---
 dlls/shell32/shell32_main.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/dlls/shell32/shell32_main.c b/dlls/shell32/shell32_main.c
index 3b34292..26f97b6 100644
--- a/dlls/shell32/shell32_main.c
+++ b/dlls/shell32/shell32_main.c
@@ -729,18 +729,24 @@ static HRESULT WINAPI window_prop_store_QueryInterface(IPropertyStore *iface, RE
 static HRESULT WINAPI window_prop_store_GetCount(IPropertyStore *iface, DWORD *count)
 {
     FIXME("%p, %p\n", iface, count);
+    *count = 0;
     return E_NOTIMPL;
 }
 
 static HRESULT WINAPI window_prop_store_GetAt(IPropertyStore *iface, DWORD prop, PROPERTYKEY *key)
 {
     FIXME("%p, %lu,%p\n", iface, prop, key);
+    memset( key, 0, sizeof(*key) );
     return E_NOTIMPL;
 }
 
 static HRESULT WINAPI window_prop_store_GetValue(IPropertyStore *iface, const PROPERTYKEY *key, PROPVARIANT *var)
 {
     FIXME("%p, {%s,%lu}, %p\n", iface, debugstr_guid(&key->fmtid), key->pid, var);
+    /* An out parameter has to be initialised even on the failure path: a caller
+     * that does not check the HRESULT would otherwise read uninitialised memory,
+     * and for VT_LPWSTR that is an arbitrary pointer. */
+    PropVariantInit( var );
     return E_NOTIMPL;
 }
 
