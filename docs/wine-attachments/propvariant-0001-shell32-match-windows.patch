From a71a32643070bd40388796ec727c8c1a8dff274d Mon Sep 17 00:00:00 2001
From: daoxiang0520 <15959866515@163.com>
Date: Fri, 18 Sep 2026 17:18:13 +0800
Subject: [PATCH] shell32: Match Windows for the window property store's out
 parameters.

Measured on a real Windows host (GitHub windows-latest, built with both MSVC and
MinGW, identical results) for a property that is not present on the window:

    GetValue  -> S_OK,   *var initialised to VT_EMPTY
    GetCount  -> E_FAIL, *count set to 0
    GetAt     -> E_FAIL, *key left untouched

and for a property that was set on the store, GetValue returns it (S_FALSE).

Wine returns E_NOTIMPL from all three without touching anything, and its store
cannot return a value that was set on it either. Match the measured behaviour.

Wine-bug: https://bugs.winehq.org/show_bug.cgi?id=60346
---
 dlls/shell32/shell32_main.c | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/dlls/shell32/shell32_main.c b/dlls/shell32/shell32_main.c
index 3b34292..56d1ac4 100644
--- a/dlls/shell32/shell32_main.c
+++ b/dlls/shell32/shell32_main.c
@@ -729,19 +729,21 @@ static HRESULT WINAPI window_prop_store_QueryInterface(IPropertyStore *iface, RE
 static HRESULT WINAPI window_prop_store_GetCount(IPropertyStore *iface, DWORD *count)
 {
     FIXME("%p, %p\n", iface, count);
-    return E_NOTIMPL;
+    *count = 0;
+    return E_FAIL;
 }
 
 static HRESULT WINAPI window_prop_store_GetAt(IPropertyStore *iface, DWORD prop, PROPERTYKEY *key)
 {
     FIXME("%p, %lu,%p\n", iface, prop, key);
-    return E_NOTIMPL;
+    return E_FAIL;
 }
 
 static HRESULT WINAPI window_prop_store_GetValue(IPropertyStore *iface, const PROPERTYKEY *key, PROPVARIANT *var)
 {
     FIXME("%p, {%s,%lu}, %p\n", iface, debugstr_guid(&key->fmtid), key->pid, var);
-    return E_NOTIMPL;
+    PropVariantInit( var );
+    return S_OK;
 }
 
 static HRESULT WINAPI window_prop_store_SetValue(IPropertyStore *iface, const PROPERTYKEY *key, const PROPVARIANT *var)
