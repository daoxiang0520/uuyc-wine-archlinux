# Maintainer: Arch Linux local adaptation of the NetEase UU Remote (网易UU远程)
# Windows client. Derived from the 0BSD-licensed uuyc-wine recipe by the
# uuyc-wine AUR contributors, retargeted to upstream 4.40.1 and a local
# installer file.
#
# The upstream product ships no Linux build. This package installs the official
# Windows installer into a private Wine prefix on first launch and applies the
# compatibility workarounds UU Remote needs on Arch Linux.

pkgname=uuyc-wine
pkgver=4.40.1
pkgrel=21
pkgdesc='NetEase UU Remote (网易UU远程) Windows client on Arch Linux, via a managed Wine prefix'
arch=('x86_64')
url='https://uuyc.163.com/'
license=('LicenseRef-UU-Remote-EULA' '0BSD')
depends=('wine>=11.0' 'hicolor-icon-theme' 'procps-ng' 'util-linux' 'diffutils' 'grep' 'pacman')
makedepends=('binutils' 'gcc' '7zip' 'wine')
optdepends=('libnotify: desktop notifications while the prefix is prepared')
options=('!strip' '!debug')
install="$pkgname.install"
_installer='uuyc-installer.exe'
_installer_dir="${startdir}/local"

# The installer is vendor software, so it is referenced from the package
# directory instead of a checksummed download. Place the official file at
# local/uuyc-installer.exe before building (see README.md).
