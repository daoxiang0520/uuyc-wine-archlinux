prepare() {
  # App icon, taken straight out of the installer's PE resources.
  rm -rf icon
  mkdir -p icon
  7z x -y -oicon "$srcdir/$_installer" '.rsrc/ICON/6' >/dev/null
  [[ -f icon/.rsrc/ICON/6 ]] || { echo 'failed to extract the application icon' >&2; return 1; }
}

build() {
  cd "$srcdir"

  # Native x86-64 wevtapi.dll compatibility layer. UU Remote's
  # GameViewerServer.exe imports wevtapi.dll; Wine's builtin implementation
  # terminates the process in an unimplemented EvtOpenPublisherMetadata stub.
  as --64 wevtapi.S -o wevtapi-elf.o
  objcopy --remove-section=.note.gnu.property -O pe-x86-64 wevtapi-elf.o wevtapi-coff.o
  ld -mi386pep --dll --no-insert-timestamp --entry=DllMain --subsystem windows \
    -o wevtapi.dll wevtapi-coff.o wevtapi.def \
    -L/usr/lib/wine/x86_64-windows -lkernel32

  # Verify that the shim really exports what the client asks for.
  exports=$(objdump -p wevtapi.dll)
  for symbol in EvtClose EvtNext EvtOpenPublisherMetadata EvtQuery EvtRender; do
    grep -qw -- "$symbol" <<<"$exports" || {
      echo "wevtapi.dll is missing the $symbol export" >&2
      return 1
    }
  done

  # Native Vulkan Video capability probe. Headerless on purpose: it resolves
  # everything through the loader with dlopen/dlsym, so it needs neither
  # vulkan-headers nor a build-time link against libvulkan. That keeps the tool
  # usable on machines where vulkan-tools is not installed.
  # Guard against a stale copy shadowing support/vkvideo/uuyc-vkvideo.c: makepkg
  # resolves a plain source filename against $startdir, so an out-of-date file
  # there silently builds the old probe. Assert the source carries the values
  # that were cross-checked against the official Vulkan headers.
  grep -q 'VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_PROFILE_INFO_KHR 1000040003u' vkvideo-probe.c || {
    echo 'vkvideo-probe.c is stale (missing the checked H.264 profile sType)' >&2
    echo 'source must come from support/vkvideo/uuyc-vkvideo.c' >&2
    return 1
  }
  grep -q 'VK_VIDEO_CODEC_OPERATION_DECODE_H264_BIT_KHR 0x00000001u' vkvideo-probe.c || {
    echo 'vkvideo-probe.c is stale (wrong H.264 codec operation bit)' >&2
    return 1
  }

  gcc -O2 -w -o uuyc-vkvideo vkvideo-probe.c -ldl
  [[ -x uuyc-vkvideo ]] || { echo 'failed to build the Vulkan Video probe' >&2; return 1; }

  # The launcher must stay inside the runtime path this package expects.
  for token in '/usr/share/uuyc-wine' 'uuyc-installer.exe' 'wevtapi.dll'; do
    grep -qF -- "$token" uuyc-wine || { echo "launcher is missing $token" >&2; return 1; }
  done

  # A PE that imports a symbol this DLL lacks fails to load, which surfaces as
  # the whole client dying instantly. This is not theoretical: it is what
  # "installing the shim makes the client crash" was. Assert the export table
  # covers every name Wine's d3d11.dll provides.
  winelib=/usr/lib/wine/x86_64-windows/d3d11.dll
  if [[ -r $winelib ]]; then
    have=$(objdump -p vdshim.dll | sed -n '/Ordinal\/Name Pointer/,/^$/p' | awk 'NF{print $NF}' | sort -u)
    want=$(objdump -p "$winelib" | sed -n '/Ordinal\/Name Pointer/,/^$/p' | awk 'NF{print $NF}' | sort -u)
    missing=$(comm -23 <(printf '%s\n' "$want") <(printf '%s\n' "$have") | grep -c . || true)
    if ((missing > 0)); then
      echo "uuyc-vdshim.dll is missing $missing export(s) that Wine's d3d11.dll provides:" >&2
      comm -23 <(printf '%s\n' "$want") <(printf '%s\n' "$have") | sed 's/^/  /' >&2
      echo "regenerate with support/vdshim/gen-forwarders.sh" >&2
      return 1
    fi
    echo "vdshim export table: complete ($(printf '%s\n' "$have" | grep -c .) symbols)"
    # The shim must hook Wine's device in place, never return a substitute object:
    # a foreign `this` makes Wine read fixed offsets out of bounds (this shipped
    # once and crashed the client in d3d11_device_GetFeatureLevel).
    grep -q 'real->lpVtbl = patched' vdshim-source.c || {
      echo 'vdshim no longer swaps the vtable in place -- it may be handing out a fake device' >&2
      return 1
    }
    if grep -qE 'return \(ID3D11Device \*\)(dp|h);' vdshim-source.c; then
      echo 'vdshim returns a substitute ID3D11Device -- this crashes Wine callers' >&2
      return 1
    fi
    # The guard that stopped the "enter desktop" crash. qwindows.dll computes
    # (char *)otm + otm->otmpFullName out of GetOutlineTextMetricsW and hands the
    # result to QString::fromWCharArray as a NUL-terminated wchar_t string, so an
    # offset Wine leaves unset becomes an unmapped pointer Qt then strlens.
    # Without the validation the client dies ~1-3s after the click, every time.
    grep -q 'wchar_terminated' vdshim-iathook.c || {
      echo 'iathook.c no longer validates the fromWCharArray pointer' >&2
      return 1
    }
  fi

  # The diagnostics tool must keep pointing at the installed probe path and the
  # ANV debug flag it documents.
  for token in 'ANV_DEBUG=video-decode' 'VK_KHR_video_decode_h264'; do
    grep -qF -- "$token" uuyc-wine-vkvideo || { echo "uuyc-wine-vkvideo is missing $token" >&2; return 1; }
  done
}

package() {
  install -Dm755 "$srcdir/uuyc-wine" "$pkgdir/usr/bin/uuyc-wine"
  install -Dm755 "$srcdir/uuyc-wine-doctor" "$pkgdir/usr/bin/uuyc-wine-doctor"
  install -Dm755 "$srcdir/uuyc-wine-gpu" "$pkgdir/usr/bin/uuyc-wine-gpu"
  install -Dm755 "$srcdir/uuyc-wine-hwdecode" "$pkgdir/usr/bin/uuyc-wine-hwdecode"
  install -Dm755 "$srcdir/uuyc-wine-crashlog" "$pkgdir/usr/bin/uuyc-wine-crashlog"
  install -Dm755 "$srcdir/uuyc-wine-d3dprobe" "$pkgdir/usr/bin/uuyc-wine-d3dprobe"
  install -Dm755 "$srcdir/uuyc-wine-vkvideo" "$pkgdir/usr/bin/uuyc-wine-vkvideo"
  install -Dm755 "$srcdir/uuyc-wine-dumpinfo" "$pkgdir/usr/bin/uuyc-wine-dumpinfo"
  install -Dm755 "$srcdir/uuyc-wine-sessioncheck" "$pkgdir/usr/bin/uuyc-wine-sessioncheck"
  install -Dm755 "$srcdir/uuyc-wine-vdshim" "$pkgdir/usr/bin/uuyc-wine-vdshim"
  install -Dm755 "$srcdir/check-abi.sh" "$pkgdir/usr/share/$pkgname/vkvideo/check-abi.sh"
  install -Dm755 "$srcdir/vdshim.dll" "$pkgdir/usr/share/$pkgname/vdshim/uuyc-vdshim.dll"
  install -Dm755 "$srcdir/vdshim-deploy.sh" "$pkgdir/usr/share/$pkgname/vdshim/deploy.sh"
  install -Dm755 "$srcdir/vdshim-gen-forwarders.sh" "$pkgdir/usr/share/$pkgname/vdshim/gen-forwarders.sh"
  install -Dm644 "$srcdir/shshim-source.c" "$pkgdir/usr/share/$pkgname/shshim/uuyc-shshim.c"
  install -Dm644 "$srcdir/shshim-forwarders.c" "$pkgdir/usr/share/$pkgname/shshim/uuyc-shshim-forwarders.c"
  install -Dm644 "$srcdir/shshim-forwarders.S" "$pkgdir/usr/share/$pkgname/shshim/uuyc-shshim-forwarders.S"
  install -Dm644 "$srcdir/shshim-forwarders.h" "$pkgdir/usr/share/$pkgname/shshim/uuyc-shshim-forwarders.h"
  install -Dm644 "$srcdir/shshim-forwarders.def" "$pkgdir/usr/share/$pkgname/shshim/uuyc-shshim-forwarders.def"
  install -Dm644 "$srcdir/shshim-test.c" "$pkgdir/usr/share/$pkgname/shshim/testshshim.c"
  install -Dm755 "$srcdir/shshim-test.exe" "$pkgdir/usr/share/$pkgname/shshim/testshshim.exe"
  install -Dm755 "$srcdir/shshim.dll" "$pkgdir/usr/share/$pkgname/shshim/uuyc-shshim.dll"
  install -Dm755 "$srcdir/shshim-deploy.sh" "$pkgdir/usr/share/$pkgname/shshim/deploy.sh"
  install -Dm755 "$srcdir/shshim-gen-forwarders.sh" "$pkgdir/usr/share/$pkgname/shshim/gen-forwarders.sh"
  # Wine-side UI control: works with the host session locked, where X capture and
  # input cannot reach the application at all.
  install -Dm644 "$srcdir/uictl-source.c" "$pkgdir/usr/share/$pkgname/uictl/uuyc-uictl.c"
  install -Dm755 "$srcdir/uictl.exe" "$pkgdir/usr/share/$pkgname/uictl/uuyc-uictl.exe"
  install -Dm644 "$srcdir/uictl-README.md" "$pkgdir/usr/share/$pkgname/uictl/README.md"
  # Evidence copy of the client's native bridge plus the protocol recovered from it.
  install -Dm644 "$srcdir/bridge-js" "$pkgdir/usr/share/$pkgname/bridge/uuycbridge.js"
  install -Dm644 "$srcdir/bridge-README.md" "$pkgdir/usr/share/$pkgname/bridge/README.md"
  # The Wine fix this whole adaptation needed, plus a script that rebuilds Wine.
  install -Dm755 "$srcdir/winepatch.sh" "$pkgdir/usr/share/$pkgname/winepatch/build-patched-wine.sh"
  install -Dm644 "$srcdir/winepatch-shell32.patch" "$pkgdir/usr/share/$pkgname/winepatch/0001-shell32-init-window-prop-store-out-params.patch"
  install -Dm644 "$srcdir/vdshim-source.c" "$pkgdir/usr/share/$pkgname/vdshim/uuyc-vdshim.c"
  install -Dm644 "$srcdir/vdshim-iathook.c" "$pkgdir/usr/share/$pkgname/vdshim/iathook.c"
  install -Dm644 "$srcdir/vdshim-test.c" "$pkgdir/usr/share/$pkgname/vdshim/testshim.c"
  install -Dm755 "$srcdir/vdshim-test.exe" "$pkgdir/usr/share/$pkgname/vdshim/testshim.exe"
  install -Dm755 "$srcdir/uuyc-vkvideo" "$pkgdir/usr/share/$pkgname/vkvideo/uuyc-vkvideo"
  install -Dm644 "$srcdir/vkvideo-probe.c" "$pkgdir/usr/share/$pkgname/vkvideo/uuyc-vkvideo.c"
  install -Dm644 "$srcdir/uuyc-d3dprobe.c" "$pkgdir/usr/share/$pkgname/d3dprobe/uuyc-d3dprobe.c"
  install -Dm644 "$srcdir/d3dprobe-README.md" "$pkgdir/usr/share/$pkgname/d3dprobe/README.md"
  install -Dm755 "$srcdir/uuyc-d3dprobe.exe" "$pkgdir/usr/share/$pkgname/d3dprobe/uuyc-d3dprobe.exe"
  install -Dm644 "$srcdir/$_installer" "$pkgdir/usr/share/$pkgname/$_installer"
  install -Dm644 "$srcdir/wevtapi.dll" "$pkgdir/usr/share/$pkgname/wevtapi.dll"
  install -Dm644 "$srcdir/uuyc-wine.desktop" "$pkgdir/usr/share/applications/uuyc-wine.desktop"
  # Merged menu entry: Wine client by default, Android client as a desktop action.
  install -Dm644 "$srcdir/uuyc.desktop" "$pkgdir/usr/share/applications/uuyc.desktop"
  install -Dm644 "$srcdir/icon/.rsrc/ICON/6" "$pkgdir/usr/share/icons/hicolor/256x256/apps/uuyc-wine.png"
  install -Dm644 "$srcdir/wine-bug-propvariant.md" "$pkgdir/usr/share/$pkgname/wine-bug-propvariant.md"
  install -Dm644 "$srcdir/qwindows-fontname-crash.md" "$pkgdir/usr/share/$pkgname/qwindows-fontname-crash.md"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  printf '%s\n' "$pkgver" >"$pkgdir/usr/share/$pkgname/upstream-version"
  printf '%s-%s\n' "$pkgver" "$pkgrel" >"$pkgdir/usr/share/$pkgname/package-release"
}
