#!/usr/bin/bash
# uuyc-wine-gpu -- explain why Wine finds no usable GPU.
#
# Run this TWICE and compare the two outputs:
#   uuyc-wine-gpu > /tmp/gpu-from-terminal.txt   # in a normal terminal
#   # then run it from the tool that shows the error and compare
#
# The remote session needs a DRM render node for hardware decode and for
# wined3d's real (non-software) renderer. When /dev/dri is missing, libva
# reports "vaGetDriverNames() failed" and wined3d falls back to llvmpipe,
# which is what makes the session crash or fail to connect.
#
# SPDX-License-Identifier: 0BSD

set -uo pipefail

ok=$'\033[32mok\033[0m'
bad=$'\033[31mFAIL\033[0m'
warn=$'\033[33mwarn\033[0m'

section() { printf '\n===== %s =====\n' "$1"; }

section "1. is this shell inside a sandbox?"
if grep -qsE 'bwrap|flatpak|systemd-nspawn' /proc/1/cmdline; then
    printf '  %s PID 1 is a sandbox wrapper:\n      %s\n' "$bad" \
        "$(tr '\0' ' ' </proc/1/cmdline | cut -c1-140)"
    printf '  A sandbox that creates its own /dev (bwrap --dev /dev) hides\n'
    printf '  /dev/dri from every process it starts. Nothing inside can fix it.\n'
elif [[ -f /.dockerenv ]]; then
    printf '  %s running inside a Docker container\n' "$bad"
    printf '  Pass the GPU through:  --device /dev/dri\n'
else
    printf '  %s no sandbox detected at PID 1\n' "$ok"
fi

section "2. DRM device nodes"
if [[ -d /dev/dri ]]; then
    printf '  %s /dev/dri exists:\n' "$ok"
    ls -la /dev/dri 2>/dev/null | sed 's/^/      /'
    for node in /dev/dri/renderD* ; do
        [[ -e $node ]] || continue
        if [[ -r $node && -w $node ]]; then
            printf '  %s %s is readable and writable\n' "$ok" "$node"
        else
            printf '  %s %s is NOT accessible by %s (add the user to the video group)\n' \
                "$bad" "$node" "$(id -un)"
        fi
    done
else
    printf '  %s /dev/dri does not exist in this namespace\n' "$bad"
    printf '      -> no hardware decode and no hardware GL for anything here.\n'
fi

section "3. kernel driver on the host"
if lsmod 2>/dev/null | grep -qE '^(i915|xe|amdgpu|nvidia|radeon)\b'; then
    lsmod | grep -E '^(i915|xe|amdgpu|nvidia|radeon)\b' | awk '{printf "  %s loaded (%s users)\n", $1, $3}'
else
    printf '  %s no GPU kernel driver loaded (or lsmod is not permitted here)\n' "$warn"
fi
lspci -nnk 2>/dev/null | grep -A2 -iE 'vga|3d|display' | sed 's/^/  /' | head -8

section "4. VA-API stack"
for pkg in intel-media-driver libva libva-utils vulkan-intel vulkan-icd-loader mesa; do
    printf '  %-22s %s\n' "$pkg" "$(pacman -Q "$pkg" 2>/dev/null || echo 'not installed')"
done
printf '  iHD driver   : %s\n' "$([[ -f /usr/lib/dri/iHD_drv_video.so ]] && echo present || echo MISSING)"
printf '  Vulkan ICDs  : %s\n' "$(ls /usr/share/vulkan/icd.d/ 2>/dev/null | tr '\n' ' ')"
if command -v vainfo >/dev/null 2>&1; then
    printf '  vainfo       :\n'
    timeout 30 vainfo 2>&1 | head -8 | sed 's/^/      /'
else
    printf '  vainfo       : not installed (pacman -S libva-utils to check VA-API)\n'
fi

section "5. what wined3d will report"
if [[ ! -d /dev/dri ]]; then
    cat <<'EOF'
  Without /dev/dri, wined3d cannot create a hardware adapter. Wine will use
  llvmpipe (software OpenGL), the streamer's D3D11 pipeline then fails while
  building the session renderer, and the client either crashes within seconds
  or gives up the connection.
EOF
else
    printf '  /dev/dri is present here, so wined3d can use it.\n'
fi

section "how to launch with a GPU"
cat <<'EOF'
  If section 1 or 2 failed, start uuyc-wine from a shell that is NOT inside
  that sandbox -- a normal desktop terminal, the desktop launcher, or:

      systemd-run --user --scope uuyc-wine

  Then confirm inside the same environment:

      ls -l /dev/dri/renderD*      # must exist and be rw for your user
      vainfo | head -5             # must list an iHD driver and a device
      WINE_D3D_CONFIG=renderer=vulkan uuyc-wine

  Fixing permissions, if the node exists but is not writable:

      sudo usermod -aG video "$USER"      # then log out and back in
EOF
