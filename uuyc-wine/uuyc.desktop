[Desktop Entry]
Type=Application
Name=NetEase UU Remote
Name[zh_CN]=网易UU远程
GenericName=Remote Desktop
GenericName[zh_CN]=远程桌面
Comment=NetEase UU Remote for Arch Linux (Wine client, or the Android client in Waydroid)
Comment[zh_CN]=Arch Linux 上的网易UU远程（Wine 客户端，或 Waydroid 中的安卓客户端）
Exec=uuyc-wine %u
TryExec=uuyc-wine
Icon=uuyc-wine
Terminal=false
Categories=Network;RemoteAccess;
Keywords=remote;desktop;streaming;game;cloud;wine;waydroid;UU Remote;UU远程;网易;
MimeType=x-scheme-handler/uuremote;
StartupNotify=true
StartupWMClass=gameviewer.exe
Actions=AndroidClient;

[Desktop Action AndroidClient]
Name=Android client (Waydroid)
Name[zh_CN]=安卓客户端（Waydroid）
Exec=uuyc-android
Icon=uuyc-android
