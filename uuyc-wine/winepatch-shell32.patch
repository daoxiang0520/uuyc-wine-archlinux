--- /tmp/shell32_main.c.orig	2026-09-18 02:43:19.198571202 +0800
+++ dlls/shell32/shell32_main.c	2026-09-18 02:43:19.214865045 +0800
@@ -729,18 +729,24 @@
 static HRESULT WINAPI window_prop_store_GetCount(IPropertyStore *iface, DWORD *count)
 {
     FIXME("%p, %p\n", iface, count);
+    *count = 0;
     return E_NOTIMPL;
 }
 
 static HRESULT WINAPI window_prop_store_GetAt(IPropertyStore *iface, DWORD prop, PROPERTYKEY *key)
 {
     FIXME("%p, %lu,%p\n", iface, prop, key);
+    memset(key, 0, sizeof(*key));
     return E_NOTIMPL;
 }
 
 static HRESULT WINAPI window_prop_store_GetValue(IPropertyStore *iface, const PROPERTYKEY *key, PROPVARIANT *var)
 {
     FIXME("%p, {%s,%lu}, %p\n", iface, debugstr_guid(&key->fmtid), key->pid, var);
+    /* An out parameter must be initialised even when the call fails: a caller
+     * that does not check the HRESULT would otherwise read uninitialised stack
+     * memory as a PROPVARIANT -- for VT_LPWSTR that is an arbitrary pointer. */
+    PropVariantInit(var);
     return E_NOTIMPL;
 }
 
